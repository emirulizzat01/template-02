{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "emirulizzat01/template-02",
    "type": "project",
    "description": "Modular Laravel and Livewire application template with reusable TALL components.",
    "keywords": [
        "laravel",
        "livewire",
        "alpinejs",
        "tailwindcss",
        "template"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.17",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan template:initialize --no-interaction",
            "@php artisan migrate --no-interaction",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently --kill-others --names server,vite \"php artisan serve\" \"npm run dev\""
        ],
        "test": "@php vendor/bin/phpunit",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan template:initialize --no-interaction",
            "@php artisan migrate --no-interaction"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": "@php vendor/bin/pint --test",
        "format": "@php vendor/bin/pint",
        "check": [
            "@lint",
            "@test",
            "npm run lint",
            "npm run build"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
