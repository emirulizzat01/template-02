APP_NAME=Signal
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_DESCRIPTION="Infrastructure monitoring and reusable TALL components."
APP_BRAND_SUBTITLE=Dashboard
APP_BRAND_ICON=activity
APP_STORAGE_KEY=template-02
MONITORING_ENABLED=true
EXAMPLES_ENABLED=true

# Demo bypass is allowed only when APP_ENV is local or testing.
SIGNAL_DEMO=false
MONITORING_POLL_SECONDS=45
MONITORING_STALE_MINUTES=5
MONITORING_RECENT_LIMIT=5
MONITORING_PER_PAGE=10
SEARCH_RESULTS_PER_GROUP=4

DB_CONNECTION=sqlite
# For MySQL or PostgreSQL, configure the following values.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set true for production HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
